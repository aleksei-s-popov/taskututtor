{
  "name": "taskututtor-server",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "cd .. && npm ci && mkdir -p server/web && cp -R site/public/. server/web/ && VITE_API_URL=/ npx vite build --outDir server/web/app --emptyOutDir",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute taskututtor --local --file=schema.sql",
    "db:remote": "wrangler d1 execute taskututtor --remote --file=schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.33.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
